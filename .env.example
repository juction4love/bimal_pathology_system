# BIMAL PATHOLOGY & DIAGNOSTIC CENTER — Cloud LIS
# Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT : Copy to .env.local and fill values. Never commit .env.local.
# PRODUCTION  : Set these as Cloudflare Pages environment variables.
#               Do NOT put service_role keys or database passwords here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Application Public URL (REQUIRED for production) ─────────────────────────
# Set to production domain on Cloudflare Pages; keep blank for local dev.
VITE_PUBLIC_APP_URL=https://lis.bimalpathology.com.np

# ── Organisation Metadata (optional overrides) ───────────────────────────────
# These are baked into the report header. Defaults are hardcoded in the app.
VITE_APP_NAME="BIMAL PATHOLOGY & DIAGNOSTIC CENTER"
VITE_APP_NAME_NEP="बिमल प्याथोलोजी एण्ड डायग्नोस्टिक सेन्टर"
VITE_APP_ADDRESS="Bharatpur-7, Chitwan, Nepal"
VITE_APP_REG_NO="7-1496"
VITE_APP_PAN="302481477"
VITE_APP_PHONE="056-593288"

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS THAT MUST NEVER APPEAR IN VITE_ VARIABLES
# (Supabase Edge Functions read these from Deno.env — NOT from the frontend)
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY  → Edge Function environment only (Supabase Dashboard)
# SPARROW_SMS_TOKEN          → Edge Function environment only
# SPARROW_SMS_FROM           → Edge Function environment only
